# Copie este arquivo para .env e ajuste os valores conforme necessário.

# Modo debug (use False em produção)
DEBUG=True

# Chave secreta do Django (troque em produção)
SECRET_KEY=troque-esta-chave-em-producao

# Hosts permitidos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados. Deixe vazio para usar SQLite (padrão em desenvolvimento).
# Para PostgreSQL em produção, use:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/jardim_esperanca
DATABASE_URL=
